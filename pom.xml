                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <phase>package</phase>
                    </execution>
                    <execution>
                        <id>aggregate</id>
                        <goals>
                            <goal>aggregate</goal>
                        </goals>
                        <phase>site</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>${site-plugin.version}</version>
                <configuration>
                    <locales>en</locales>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <!-- 0.8.15 supports Java 26 class files; 0.8.12 fails to instrument
                     them (the JDK on this machine is newer than the Java 21 target). -->
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <!--
                            Instrument plain (non-@QuarkusTest) unit tests, appending into the
                            same jacoco-quarkus.exec the quarkus-jacoco extension writes for
                            @QuarkusTest runs. exclClassLoaders is required: without it this
                            agent also tries to instrument QuarkusClassLoader-loaded classes,
                            which fights the extension's own instrumentation and left it unable
                            to ever write its data file (see the Quarkus JaCoCo guide's
                            "Coverage for tests not using @QuarkusTest" section).
                        -->
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-quarkus.exec</destFile>
                            <append>true</append>
                            <exclClassLoaders>*QuarkusClassLoader</exclClassLoaders>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-quarkus.exec</dataFile>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-quarkus.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <excludes>
                                <!-- Quarkus-generated proxies and subclasses -->
                                <exclude>**/*$$*</exclude>
                                <exclude>**/*_ClientProxy*</exclude>
                                <exclude>**/*_Subclass*</exclude>
                                <exclude>**/*_Bean*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                    Pitest mutation testing (https://pitest.org). Not bound to any phase: it is slow
                    and on demand only, run as `./mvnw test-compile pitest:mutationCoverage`, with the
                    report at target/pit-reports/index.html.

                    targetTests names the plain unit tests one by one, on purpose. A @QuarkusTest (or
                    QuarkusBrowserlessTest) loads the application through QuarkusClassLoader, which
                    reads the original bytes from target/classes and never sees Pitest's mutant, so
                    every mutant it covers would be reported as surviving; it would also boot the
                    application and a PostgreSQL container once per mutant. There is no glob that
                    separates the two kinds, so a new plain unit test is added here by hand; leaving
                    one out only lowers the score, where wrongly including a booted test would
                    falsify it.
                -->
