                        <param>com.elicitsoftware.service.SurveyDefinitionUpdateServiceUnitTest</param>
                        <param>com.elicitsoftware.service.SurveyLogServiceUnitTest</param>
                        <param>com.elicitsoftware.service.TranslatableFieldsParityTest</param>
                        <param>com.elicitsoftware.util.LogMaskingTest</param>
                        <param>com.elicitsoftware.util.RandomStringTest</param>
                    </targetTests>
                    <jvmArgs>
                        <jvmArg>-Djava.util.logging.manager=org.jboss.logmanager.LogManager</jvmArg>
                    </jvmArgs>
                    <outputFormats>
                        <format>HTML</format>
                        <format>XML</format>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <threads>4</threads>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>2.7.1</version>
                <configuration>
                    <inceptionYear>2025</inceptionYear>
                    <licenseName>polyform</licenseName>
                    <organizationName>The Regents of the University of Michigan - Rogel Cancer Center</organizationName>
                    <projectName>Elicit Survey</projectName>
                    <emptyLineAfterHeader>true</emptyLineAfterHeader>
                    <excludes>
                        <exclude>**/*.properties</exclude>
                        <!-- JSON has no comment syntax: a header makes the file unparseable.
                             This covers brand-config.json, brand-info.json, typography.json,
                             i18n-config.json and anything added later. -->
                        <exclude>**/*.json</exclude>
                    </excludes>
                    <licenseResolver>${project.baseUri}src/license</licenseResolver>
                    <processStartTag>***LICENSE_START***</processStartTag>
                    <processEndTag>***LICENSE_END***</processEndTag>
                    <connectTimeout>3000</connectTimeout>
                    <socketTimeout>3000</socketTimeout>
                    <errorRemedy>ignore</errorRemedy>
                </configuration>
                <executions>
                    <execution>
                        <id>first</id>
                        <goals>
                            <goal>update-file-header</goal>
                        </goals>
                        <phase>process-sources</phase>
                    </execution>
                    <execution>
                        <id>add-third-party-licenses</id>
                        <goals>
                            <goal>add-third-party</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>aggregate-download-licenses</id>
                        <goals>
                            <goal>aggregate-download-licenses</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${javadoc-plugin.version}</version>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>javadoc</report>
                            <report>aggregate</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <version>3.9.0</version>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>index</report>
                            <report>summary</report>
                            <report>dependency-info</report>
                            <report>modules</report>
                            <report>team</report>
                            <report>scm</report>
                            <report>issue-management</report>
                            <report>mailing-lists</report>
                            <report>dependency-management</report>
                            <report>dependencies</report>
                            <report>dependency-convergence</report>
                            <report>ci-management</report>
                            <report>plugin-management</report>
                            <report>plugins</report>
                            <report>distribution-management</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
        </plugins>
    </reporting>

    <profiles>
        <profile>
            <!-- Vaadin dev tools (dev server, Copilot, dev bundle) for dev mode and tests.
                 Active only when no -Dquarkus.profile is passed on the Maven command line, so
                 the image build (-Dquarkus.profile=docker) keeps them off the build classpath.
                 Quarkus packages optional dependencies, and filtering them only at packaging
                 time breaks startup because augmentation has already generated a bean for
                 vaadin-dev's DevModeStartupListener. -->
            <id>vaadin-dev-tools</id>
            <activation>
                <property>
                    <name>!quarkus.profile</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.vaadin</groupId>
                    <artifactId>vaadin-dev</artifactId>
                    <optional>true</optional>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
        <profile>
            <id>production</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.vaadin</groupId>
                        <artifactId>vaadin-maven-plugin</artifactId>
                        <version>${vaadin.version}</version>
                        <configuration>
                            <frontendHotdeploy>true</frontendHotdeploy>
                        </configuration>
                        <executions>
                            <execution>
                                <phase>compile</phase>
                                <goals>
                                    <goal>prepare-frontend</goal>
                                    <goal>build-frontend</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
